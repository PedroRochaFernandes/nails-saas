# Configuração do nAIls. Copie para .env e preencha (o .env não vai para o GitHub).
# Linhas vazias ou comentadas usam o padrão.

# ---------- Endereço público (links nas mensagens) ----------
# PUBLIC_URL=https://seu-dominio.com.br

# ---------- Cobrança (Stripe) ----------
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ---------- WhatsApp automático (Meta) ----------
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_VESPERA=nails_lembrete_vespera
# WHATSAPP_TEMPLATE_2H=nails_aviso_2h
# WHATSAPP_TEMPLATE_VAGA=nails_vaga
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
